{
  "title": "AI Prompt Gateway",
  "uid": "ai-gateway-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request rate (/api/generate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_request_duration_seconds_count{route=\"/api/generate\"}[5m]))",
          "legendFormat": "requests/sec"
        }
      ]
    },
    {
      "id": 2,
      "title": "p95 latency (/api/generate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{route=\"/api/generate\"}[5m])) by (le))",
          "legendFormat": "p95 seconds"
        }
      ]
    },
    {
      "id": 3,
      "title": "Prompts routed, by template",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(gateway_prompts_total[5m])) by (template)",
          "legendFormat": "{{template}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "\"Best answer\" picks, by provider",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(increase(gateway_provider_selected_total[24h])) by (provider)",
          "legendFormat": "{{provider}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Pod CPU usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"ai-gateway\", pod=~\"ai-gateway.*\"}[5m])) by (pod)",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Pod memory usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"ai-gateway\", pod=~\"ai-gateway.*\"}) by (pod)",
          "legendFormat": "{{pod}}"
        }
      ]
    }
  ]
}

